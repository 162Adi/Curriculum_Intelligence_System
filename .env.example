# ==============================================================================
# Curriculum Intelligence System (CIS) — Environment Configuration
# ==============================================================================

APP_ENV=development
DEBUG=True
SECRET_KEY=cis-super-secret-production-grade-key-at-least-32-chars-long-2026

# Database (PostgreSQL with pgvector for production / local Docker)
# Will seamlessly fall back to local sqlite+aiosqlite in development if Postgres is offline
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cis_db

# LLM Provider Configuration (gemini, openai, claude, local)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Embeddings Provider (local, gemini, openai)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004

# Adzuna Job Market API (India Tech Markets: BLR, HYD, PNQ, BOM)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Deep Research Web Search Provider (serpapi, tavily, duckduckgo)
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=

# OpenClaw Gateway Service
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=

# Model Context Protocol (MCP) Server
MCP_SERVER_URL=http://localhost:8001

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
